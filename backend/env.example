# Конфигурация базы данных
# Для SQLite (по умолчанию)
DATABASE_URL=sqlite:///./afisha.db

# Для PostgreSQL (раскомментируйте и настройте при необходимости)
# POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
# DATABASE_URL=postgresql://username:password@localhost:5432/afisha_db

# Секретный ключ для JWT токенов (ОБЯЗАТЕЛЬНО измените в продакшене!)
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Алгоритм для JWT
ALGORITHM=HS256

# Время жизни токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Данные администратора
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_EMAIL=admin@afisha.ru


