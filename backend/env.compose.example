# Example for Docker Compose only; copy to backend/.env and replace every placeholder.
# URL-encode special characters in DATABASE_URL's password.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://afisha:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@db:5432/afisha_db
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.com
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_ACCOUNT_LIMIT=5
LOGIN_SOURCE_LIMIT=30
LOGIN_WINDOW_SECONDS=900

# Localhost-only published ports. Change them for parallel test stacks.
BACKEND_PORT=8039
POSTGRES_PORT=5439

# Runtime data. The default DB volume name preserves existing installations.
# Use a unique POSTGRES_VOLUME_NAME for isolated tests or parallel projects.
POSTGRES_VOLUME_NAME=afisha_db_data
UPLOADS_PATH=./app/static/uploads

# Set these to `id -u` and `id -g` of the deployment user when they differ.
BACKEND_UID=1000
BACKEND_GID=1000
