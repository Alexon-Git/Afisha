# Copy with scripts/init-env.sh (generates random secrets, chmod 600). Never commit .env.staging.
COMPOSE_PROJECT_NAME=afisha-staging
# Image refs are printed by scripts/build-images.sh (tagged with the full commit SHA).
BACKEND_IMAGE=afisha-staging/backend:REPLACE_WITH_COMMIT_SHA
PUBLIC_IMAGE=afisha-staging/public:REPLACE_WITH_COMMIT_SHA
NGINX_IMAGE=afisha-staging/nginx:REPLACE_WITH_COMMIT_SHA
# Must not overlap any existing Docker network (run scripts/preflight.sh). NGINX_IP lies inside the subnet.
STAGING_INTERNAL_SUBNET=172.30.211.0/29
STAGING_NGINX_IP=172.30.211.2
# Loopback only. Changing STAGING_BIND exposes the gate; do that only with the approved HTTPS ingress.
STAGING_BIND=127.0.0.1
STAGING_PORT=18080
STAGING_HTPASSWD=./secrets/staging.htpasswd
POSTGRES_PASSWORD=GENERATED
SECRET_KEY=GENERATED
ADMIN_USERNAME=staging-admin
ADMIN_PASSWORD=GENERATED
