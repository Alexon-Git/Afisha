# Local host development only. Docker uses http://backend:8039 instead.
INTERNAL_API_URL=http://127.0.0.1:8039
# Build-time browser setting; requires a reverse proxy (PR-12).
NEXT_PUBLIC_API_BASE=/api
NEXT_TELEMETRY_DISABLED=1
# Set only after the owner approves the public origin. Empty means noindex.
SITE_URL=
# Tests may explicitly allow localhost. Leave disabled for normal deployment.
ALLOW_LOCAL_SITE_URL=0
